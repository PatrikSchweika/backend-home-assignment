{
  "name": "backend-home-assignment",
  "version": "1.0.0",
  "scripts": {
    "collector": "tsx src/collector.ts",
    "writer": "tsx src/writer.ts",
    "all": "concurrently -n collector,writer -c blue,green \"pnpm collector\" \"pnpm writer\"",
    "build": "tsc --outDir dist",
    "test": "vitest run"
  },
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "amqplib": "^2.0.1",
    "dotenv": "^17.4.2",
    "kysely": "^0.29.2",
    "mqtt": "^5.15.1",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "concurrently": "^10.0.3",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
